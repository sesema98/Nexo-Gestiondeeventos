@model Asistente
@{ ViewData["Title"] = "Nuevo asistente"; }
<div class="page-header"><div><h1 class="page-title">Nuevo asistente</h1><p class="page-subtitle">Registra sus datos para habilitarlo en las inscripciones.</p></div></div><form asp-action="Create" method="post" class="surface form-card"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="Nombres" class="form-label"></label><input asp-for="Nombres" class="form-control"/><span asp-validation-for="Nombres" class="text-danger"></span></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="Dni" class="form-label"></label><input asp-for="Dni" class="form-control"/><span asp-validation-for="Dni" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="Telefono" class="form-label"></label><input asp-for="Telefono" class="form-control"/><span asp-validation-for="Telefono" class="text-danger"></span></div></div><div class="mb-3"><label asp-for="Correo" class="form-label"></label><input asp-for="Correo" class="form-control"/><span asp-validation-for="Correo" class="text-danger"></span></div><div class="d-flex gap-2 mt-4"><button class="btn btn-primary">Guardar asistente</button><a asp-action="Index" class="btn btn-light">Cancelar</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
