<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Nexo Eventos</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Eventos.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark app-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Eventos" asp-action="Index" aria-label="Nexo Eventos, inicio">
                    <img class="brand-logo" src="~/images/nexo-logo.svg" alt="" />
                    <span class="brand-copy"><strong>Nexo</strong><small>Eventos</small></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse justify-content-end">
                    <ul class="navbar-nav gap-md-1">
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Eventos" ? "active" : "")" asp-controller="Eventos" asp-action="Index"><span class="nav-symbol">▦</span> Eventos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Asistentes" ? "active" : "")" asp-controller="Asistentes" asp-action="Index"><span class="nav-symbol">♙</span> Asistentes</a>
                        </li>
                        <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Inscripciones" ? "active" : "")" asp-controller="Inscripciones" asp-action="Index"><span class="nav-symbol">✓</span> Inscripciones</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container app-container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <div class="container">
            <div class="footer-inner"><span><strong>Nexo Eventos</strong> · Gestión de eventos e inscripciones</span><span>2026</span></div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
