@model IEnumerable<EventoListadoViewModel>
@{ ViewData["Title"] = "Eventos"; }
<div class="page-header"><div><h1 class="page-title">Próximos eventos</h1><p class="page-subtitle">Consulta el aforo, los inscritos y los cupos disponibles.</p></div><a asp-action="Create" class="btn btn-primary">＋ Nuevo evento</a></div>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">✓ @mensaje</div> }
<form method="get" class="toolbar surface"><div><label class="form-label small" for="categoriaId">Categoría</label><select id="categoriaId" name="categoriaId" asp-items="ViewBag.Categorias" class="form-select"></select></div><button class="btn btn-outline-primary">Aplicar filtro</button><a asp-action="Index" class="btn btn-light">Limpiar</a></form>
<div class="surface table-shell table-responsive"><table class="table align-middle"><thead><tr><th>Evento</th><th>Fecha</th><th>Categoría</th><th>Modalidad</th><th>Aforo</th><th>Inscritos</th><th>Cupos</th><th class="text-end">Acciones</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td><div class="record-title">@item.Evento.Titulo</div><div class="record-meta">@item.Evento.Lugar</div></td><td class="text-nowrap">@item.Evento.Fecha.ToString("dd/MM/yyyy")<div class="record-meta">@item.Evento.Fecha.ToString("HH:mm") h</div></td><td>@item.Evento.Categoria.Nombre</td><td><span class="badge-soft @(item.Evento.Modalidad == "Virtual" ? "badge-virtual" : "badge-presencial")">@item.Evento.Modalidad</span></td><td class="metric">@item.Evento.Aforo</td><td class="metric">@item.InscritosConfirmados</td><td class="metric metric-cupos">@item.CuposDisponibles</td><td><div class="action-links"><a class="btn-action" asp-action="Details" asp-route-id="@item.Evento.Id">Ver</a><a class="btn-action" asp-action="Edit" asp-route-id="@item.Evento.Id">Editar</a><a class="btn-action text-danger" asp-action="Delete" asp-route-id="@item.Evento.Id">Eliminar</a></div></td></tr> }
@if (!Model.Any()) { <tr><td colspan="8" class="empty-state">No hay eventos que coincidan con el filtro.</td></tr> }
</tbody></table></div>
