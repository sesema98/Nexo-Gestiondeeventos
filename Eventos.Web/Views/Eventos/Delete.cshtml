@model Evento
@{ ViewData["Title"] = "Eliminar evento"; }
<h1>Eliminar evento</h1><p>¿Deseas desactivar el evento <strong>@Model.Titulo</strong>? La eliminación será lógica.</p><form asp-action="Delete" method="post"><input asp-for="Id" type="hidden"/><button class="btn btn-danger">Desactivar</button> <a asp-action="Index" class="btn btn-secondary">Cancelar</a></form>
