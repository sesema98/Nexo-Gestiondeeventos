@model Inscripcion
@{ ViewData["Title"] = "Nueva inscripción"; }
<div class="page-header"><div><h1 class="page-title">Nueva inscripción</h1><p class="page-subtitle">Relaciona un asistente con un evento que tenga cupos.</p></div></div><form asp-action="Create" method="post" class="surface form-card"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-4"><label asp-for="EventoId" class="form-label"></label><select asp-for="EventoId" asp-items="ViewBag.Eventos" class="form-select"><option value="">Selecciona un evento</option></select><span asp-validation-for="EventoId" class="text-danger"></span></div><div class="mb-3"><label asp-for="AsistenteId" class="form-label"></label><select asp-for="AsistenteId" asp-items="ViewBag.Asistentes" class="form-select"><option value="">Selecciona un asistente</option></select><span asp-validation-for="AsistenteId" class="text-danger"></span></div><div class="d-flex gap-2 mt-4"><button class="btn btn-primary">Confirmar inscripción</button><a asp-action="Index" class="btn btn-light">Cancelar</a></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
